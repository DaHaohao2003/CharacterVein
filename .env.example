# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=字脉
API_INTERNAL_URL=http://api:8000

# PostgreSQL / pgvector
POSTGRES_DB=character_vein
POSTGRES_USER=character_vein
POSTGRES_PASSWORD=character_vein_dev
DATABASE_URL=postgresql+asyncpg://character_vein:character_vein_dev@postgres:5432/character_vein
CHECKPOINT_DATABASE_URL=postgresql://character_vein:character_vein_dev@postgres:5432/character_vein

# MinIO / S3-compatible storage
MINIO_ROOT_USER=character_vein
MINIO_ROOT_PASSWORD=character_vein_dev_secret
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=character_vein
S3_SECRET_KEY=character_vein_dev_secret
S3_BUCKET=character-vein
S3_REGION=us-east-1

# Model providers (left empty until a provider is selected)
LLM_PROVIDER=aliyun-bailian
LLM_API_KEY=
LLM_BASE_URL=https://llm-c35j8p0zzuzap8p1.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_AUDIT_ENABLED=true
EMBEDDING_PROVIDER=aliyun-bailian
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# Reuses the configured Bailian key/workspace and persists title, URL and search summaries.
WEB_SEARCH_PROVIDER=aliyun-bailian
VLM_PROVIDER=aliyun-bailian
VLM_BASE_URL=
VLM_MODEL=qwen3.8-flash
